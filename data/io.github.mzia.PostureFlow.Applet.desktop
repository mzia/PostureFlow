[Desktop Entry]
Name=PostureFlow Applet
Comment=COSMIC Panel Applet for PostureFlow Posture Management
Exec=postureflow-applet
Icon=security-high-symbolic
Terminal=false
Type=Application
Categories=System;Settings;COSMIC;
StartupNotify=false
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
