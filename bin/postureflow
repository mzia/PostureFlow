#!/usr/bin/env bash
# ==============================================================================
# PostureFlow (postureflow)
# ==============================================================================
# Context-aware security, developer, and lifestyle profile manager for Pop!_OS.
# GitHub: https://github.com/mzia/PostureFlow
# ==============================================================================

set -eo pipefail

BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
RED="\033[0;31m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
MAGENTA="\033[0;35m"
NC="\033[0m"

log_info()    { echo -e "${BLUE}[*]${NC} $1"; }
log_success() { echo -e "${GREEN}[+]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[!]${NC} $1"; }
log_error()   { echo -e "${RED}[-]${NC} $1"; }
log_title()   { echo -e "\n${BOLD}${CYAN}=== $1 ===${NC}"; }

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
VERSION="1.0.0"
STATE_FILE="/etc/postureflow-state"
SYSCTL_CONF="/etc/sysctl.d/99-postureflow.conf"
LIMITS_CONF="/etc/security/limits.d/99-postureflow.conf"

DEV_PORTS=(3000 5000 5173 8000 8080 8888 9000)

save_state() {
    local p="$1"
    echo "$p" > "$STATE_FILE"
    # Notify D-Bus system daemon if active
    if command -v busctl >/dev/null 2>&1; then
        busctl call io.github.mzia.PostureFlow /io/github/mzia/PostureFlow io.github.mzia.PostureFlow SetProfile s "$p" 2>/dev/null || true
    fi
}


get_current_profile() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE" 2>/dev/null || echo "unknown"
    else
        echo "default"
    fi
}

set_desktop_idle_delay() {
    local seconds="$1"
    local target_user="${SUDO_USER:-$USER}"

    if [ -n "$target_user" ] && command -v gsettings >/dev/null 2>&1; then
        local user_uid
        user_uid=$(id -u "$target_user" 2>/dev/null || echo "1000")
        local dbus_bus="/run/user/${user_uid}/bus"
        if [ -S "$dbus_bus" ]; then
            sudo -u "$target_user" DBUS_SESSION_BUS_ADDRESS="unix:path=$dbus_bus" \
                gsettings set org.gnome.desktop.session idle-delay "$seconds" 2>/dev/null || true
        else
            gsettings set org.gnome.desktop.session idle-delay "$seconds" 2>/dev/null || true
        fi
        log_info "Desktop screen idle-lock set to $((seconds / 60)) minutes."
    fi
}

ensure_ssh_safety() {
    local ssh_active=0
    if [ -n "${SSH_CLIENT:-}" ] || [ -n "${SSH_CONNECTION:-}" ] || [ -n "${SSH_TTY:-}" ]; then
        ssh_active=1
    fi
    if command -v ss >/dev/null 2>&1; then
        if ss -tulpn 2>/dev/null | grep -qE ':(22)\b.*sshd'; then
            ssh_active=1
        fi
    fi
    if [ "$ssh_active" -eq 1 ]; then
        log_warn "Active SSH session or SSH daemon detected!"
        log_info "Applying explicit UFW allow rule for port 22 to prevent remote lockout..."
        ufw allow 22/tcp comment "SSH Anti-Lockout" >/dev/null 2>&1 || true
        log_success "Port 22/tcp (SSH) preserved."
    fi
}

clean_ufw_custom_rules() {
    for port in "${DEV_PORTS[@]}"; do
        ufw delete allow "${port}/tcp" >/dev/null 2>&1 || true
    done
    ufw delete allow 3000:3005/tcp >/dev/null 2>&1 || true

    ufw delete allow 1714:1764/tcp >/dev/null 2>&1 || true
    ufw delete allow 1714:1764/udp >/dev/null 2>&1 || true
    ufw delete allow 53317/tcp >/dev/null 2>&1 || true
    ufw delete allow 53317/udp >/dev/null 2>&1 || true
    ufw delete allow 27031:27036/udp >/dev/null 2>&1 || true
    ufw delete allow 27036:27037/tcp >/dev/null 2>&1 || true
    ufw delete allow 27040/tcp >/dev/null 2>&1 || true
    ufw delete allow 5353/udp >/dev/null 2>&1 || true
    ufw delete allow 1900/udp >/dev/null 2>&1 || true
    ufw delete allow 631/tcp >/dev/null 2>&1 || true
}

show_status() {
    log_title "Pop!_OS Context Posture (postureflow v$VERSION)"

    local profile
    profile=$(get_current_profile)
    case "$profile" in
        home)   echo -e "${BOLD}Current Profile:${NC} ${MAGENTA}${BOLD}[HOME / CASUAL / GAMING]${NC}" ;;
        work)   echo -e "${BOLD}Current Profile:${NC} ${BLUE}${BOLD}[WORK / OFFICE / VPN]${NC}" ;;
        dev)    echo -e "${BOLD}Current Profile:${NC} ${GREEN}${BOLD}[DEV / CODING MODE]${NC}" ;;
        travel|secure) echo -e "${BOLD}Current Profile:${NC} ${RED}${BOLD}[TRAVEL / HARDENED LOCKDOWN]${NC}" ;;
        *)      echo -e "${BOLD}Current Profile:${NC} ${YELLOW}${BOLD}[DEFAULT / UNCONFIGURED]${NC}" ;;
    esac

    echo ""
    echo -e "${BOLD}--- Kernel, Memory & Process Parameters ---${NC}"
    local ptrace inotify map_count dmesg kptr bpf coredump
    ptrace=$(sysctl -n kernel.yama.ptrace_scope 2>/dev/null || echo "N/A")
    inotify=$(sysctl -n fs.inotify.max_user_watches 2>/dev/null || echo "N/A")
    map_count=$(sysctl -n vm.max_map_count 2>/dev/null || echo "N/A")
    dmesg=$(sysctl -n kernel.dmesg_restrict 2>/dev/null || echo "N/A")
    kptr=$(sysctl -n kernel.kptr_restrict 2>/dev/null || echo "N/A")
    bpf=$(sysctl -n kernel.unprivileged_bpf_disabled 2>/dev/null || echo "N/A")
    coredump=$(sysctl -n fs.suid_dumpable 2>/dev/null || echo "N/A")

    if [ "$ptrace" = "2" ]; then
        echo -e "  • ptrace_scope:       ${RED}2 (Hardened - Memory scraping blocked)${NC}"
    elif [ "$ptrace" = "1" ]; then
        echo -e "  • ptrace_scope:       ${GREEN}1 (Permitted - Debuggers & Steam Overlay hook)${NC}"
    elif [ "$ptrace" = "0" ]; then
        echo -e "  • ptrace_scope:       ${YELLOW}0 (Permissive - Full attach)${NC}"
    fi

    echo -e "  • inotify file watches:${BOLD} $inotify${NC} (Higher allows large project hot-reloading)"
    echo -e "  • vm.max_map_count:    ${BOLD} $map_count${NC} (>=1048576 prevents Proton game crashes)"
    echo -e "  • dmesg_restrict:      $dmesg (1 = Root only, 0 = User readable)"
    echo -e "  • kptr_restrict:       $kptr (Kernel symbol address censoring)"
    echo -e "  • unprivileged_bpf:    $bpf (2 = Root managed, 1 = Locked)"
    echo -e "  • suid_dumpable:       $coredump (0 = No crash dumps, 2 = gdb debugging)"

    echo ""
    echo -e "${BOLD}--- Desktop Session Idle Lock ---${NC}"
    if command -v gsettings >/dev/null 2>&1; then
        local idle_sec
        idle_sec=$(gsettings get org.gnome.desktop.session idle-delay 2>/dev/null | awk '{print $2}' || echo "300")
        echo -e "  • Screen Lock Timeout: $((idle_sec / 60)) minutes ($idle_sec seconds)"
    fi

    echo ""
    echo -e "${BOLD}--- Network & Firewall (UFW) ---${NC}"
    if command -v ufw >/dev/null 2>&1; then
        local ufw_status
        ufw_status=$(ufw status 2>/dev/null || echo "inactive")
        if echo "$ufw_status" | grep -qi "Status: active"; then
            echo -e "  • UFW Firewall:        ${GREEN}Active${NC}"
            echo "  • Configured Rules:"
            echo "$ufw_status" | grep -v "Status: active" | sed 's/^/      /' || true
        else
            echo -e "  • UFW Firewall:        ${RED}Inactive / Disabled${NC}"
        fi
    fi

    local syncookies rp_filter
    syncookies=$(sysctl -n net.ipv4.tcp_syncookies 2>/dev/null || echo "N/A")
    rp_filter=$(sysctl -n net.ipv4.conf.all.rp_filter 2>/dev/null || echo "N/A")
    echo -e "  • TCP SYN Cookies:     $syncookies (1 = Anti-SYN Flood active)"
    echo -e "  • Anti-Spoof (rp_filter): $rp_filter (1 = Strict, 2 = Loose)"

    echo ""
    echo -e "${BOLD}--- Active Listening Ports ---${NC}"
    if command -v ss >/dev/null 2>&1; then
        local listening
        listening=$(ss -tuln | grep LISTEN || true)
        if [ -n "$listening" ]; then
            echo "$listening" | awk '{printf "      %-7s %-25s\n", $1, $5}'
        else
            echo "      (None detected)"
        fi
    fi
}

apply_home_profile() {
    log_title "Activating HOME Mode (Streaming, Gaming, Media & Sync)"

    log_info "Configuring kernel sysctl for gaming, Proton, and streaming..."
    cat << 'EOF' > "$SYSCTL_CONF"
kernel.yama.ptrace_scope = 1
kernel.dmesg_restrict = 0
kernel.kptr_restrict = 1
kernel.unprivileged_bpf_disabled = 2
fs.suid_dumpable = 2
vm.max_map_count = 1048576
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 512
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_rfc1337 = 1
EOF
    sysctl -p "$SYSCTL_CONF" >/dev/null 2>&1 || true

    log_info "Configuring UFW for trusted home devices (Steam, LocalSend, GSConnect)..."
    ufw --force default deny incoming >/dev/null 2>&1
    ufw --force default allow outgoing >/dev/null 2>&1
    ufw allow in on lo >/dev/null 2>&1 || true
    ufw allow out on lo >/dev/null 2>&1 || true

    clean_ufw_custom_rules
    ufw allow 27031:27036/udp comment "Steam Remote Play" >/dev/null 2>&1 || true
    ufw allow 27036:27037/tcp comment "Steam Remote Play" >/dev/null 2>&1 || true
    ufw allow 27040/tcp comment "Steam LAN Game Download" >/dev/null 2>&1 || true
    ufw allow 1714:1764/tcp comment "GSConnect Phone Sync" >/dev/null 2>&1 || true
    ufw allow 1714:1764/udp comment "GSConnect Phone Sync" >/dev/null 2>&1 || true
    ufw allow 53317/tcp comment "LocalSend File Share" >/dev/null 2>&1 || true
    ufw allow 53317/udp comment "LocalSend File Share" >/dev/null 2>&1 || true
    ufw allow 5353/udp comment "mDNS Chromecast" >/dev/null 2>&1 || true

    ensure_ssh_safety
    ufw --force enable >/dev/null 2>&1

    set_desktop_idle_delay 1800
    save_state "home"
    log_success "HOME Profile is now ACTIVE!"
}

apply_work_profile() {
    log_title "Activating WORK Mode (Office, Corporate VPN & Compliance)"

    log_info "Configuring kernel sysctl for corporate compliance..."
    cat << 'EOF' > "$SYSCTL_CONF"
kernel.yama.ptrace_scope = 1
kernel.dmesg_restrict = 1
kernel.kptr_restrict = 1
kernel.unprivileged_bpf_disabled = 2
fs.suid_dumpable = 0
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 512
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_rfc1337 = 1
EOF
    sysctl -p "$SYSCTL_CONF" >/dev/null 2>&1 || true

    log_info "Configuring UFW for corporate VPNs and office printing..."
    ufw --force default deny incoming >/dev/null 2>&1
    ufw --force default allow outgoing >/dev/null 2>&1
    ufw allow in on lo >/dev/null 2>&1 || true
    ufw allow out on lo >/dev/null 2>&1 || true

    clean_ufw_custom_rules
    for iface_pattern in "tun+" "tap+" "wg+" "tailscale+"; do
        ufw allow in on "$iface_pattern" comment "Corporate VPN" >/dev/null 2>&1 || true
        ufw allow out on "$iface_pattern" comment "Corporate VPN" >/dev/null 2>&1 || true
    done
    ufw allow 631/tcp comment "Office Printing (CUPS)" >/dev/null 2>&1 || true
    ufw allow 5353/udp comment "Office mDNS Discovery" >/dev/null 2>&1 || true

    ensure_ssh_safety
    ufw --force enable >/dev/null 2>&1

    set_desktop_idle_delay 300

    log_info "Optimizing CPU energy performance for responsive video calls & office workloads..."
    if [ -d /sys/devices/system/cpu/cpufreq ]; then
        for epp_file in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
            if [ -w "$epp_file" ]; then
                echo "balance_performance" > "$epp_file" 2>/dev/null || true
            fi
        done
    fi
    if command -v system76-power >/dev/null 2>&1; then
        system76-power profile balanced >/dev/null 2>&1 || true
        system76-power charge-thresholds --max 80 >/dev/null 2>&1 || true
    elif command -v powerprofilesctl >/dev/null 2>&1; then
        powerprofilesctl set balanced >/dev/null 2>&1 || true
    fi

    save_state "work"
    log_success "WORK Profile is now ACTIVE!"
}

apply_dev_profile() {
    log_title "Activating DEVELOPER / CODING Mode"

    log_info "Configuring dev-friendly kernel sysctl rules..."
    cat << 'EOF' > "$SYSCTL_CONF"
kernel.yama.ptrace_scope = 1
kernel.dmesg_restrict = 0
kernel.kptr_restrict = 1
kernel.unprivileged_bpf_disabled = 2
fs.suid_dumpable = 2
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 512
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_rfc1337 = 1
EOF
    sysctl -p "$SYSCTL_CONF" >/dev/null 2>&1 || true

    log_info "Enabling core dump capabilities for debugging..."
    cat << 'EOF' > "$LIMITS_CONF"
* soft core unlimited
EOF

    log_info "Configuring UFW firewall for local development..."
    ufw --force default deny incoming >/dev/null 2>&1
    ufw --force default allow outgoing >/dev/null 2>&1
    ufw allow in on lo >/dev/null 2>&1 || true
    ufw allow out on lo >/dev/null 2>&1 || true

    clean_ufw_custom_rules
    for iface in docker0 podman0; do
        if ip link show "$iface" >/dev/null 2>&1; then
            ufw allow in on "$iface" >/dev/null 2>&1 || true
            ufw allow out on "$iface" >/dev/null 2>&1 || true
        fi
    done

    for port in "${DEV_PORTS[@]}"; do
        ufw allow "${port}/tcp" comment "Dev local port" >/dev/null 2>&1 || true
    done

    ensure_ssh_safety
    ufw --force enable >/dev/null 2>&1

    set_desktop_idle_delay 900
    save_state "dev"
    log_success "Developer / Coding Profile is now ACTIVE!"
}

apply_travel_profile() {
    log_title "Activating TRAVEL / HARDENED Mode (Lockdown & Public Wi-Fi)"

    if ! dpkg -l | grep -q "[ ]unattended-upgrades"; then
        log_info "Installing unattended-upgrades for automatic CVE patching..."
        apt-get update -qq && apt-get install -y -qq unattended-upgrades
    fi

    log_info "Applying hardened kernel sysctl rules..."
    cat << 'EOF' > "$SYSCTL_CONF"
kernel.yama.ptrace_scope = 2
kernel.dmesg_restrict = 1
kernel.kptr_restrict = 2
kernel.unprivileged_bpf_disabled = 2
fs.suid_dumpable = 0
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_rfc1337 = 1
EOF
    sysctl -p "$SYSCTL_CONF" >/dev/null 2>&1 || true

    log_info "Restricting crash core dumps in security limits..."
    cat << 'EOF' > "$LIMITS_CONF"
* hard core 0
* soft core 0
EOF

    log_info "Configuring and locking down UFW firewall..."
    ufw --force default deny incoming >/dev/null 2>&1
    ufw --force default allow outgoing >/dev/null 2>&1
    ufw allow in on lo >/dev/null 2>&1 || true
    ufw allow out on lo >/dev/null 2>&1 || true

    clean_ufw_custom_rules
    ensure_ssh_safety

    ufw logging low >/dev/null 2>&1
    ufw --force enable >/dev/null 2>&1

    set_desktop_idle_delay 300
    save_state "travel"
    log_success "Travel / Hardened Security Profile is now ACTIVE!"
}

apply_secure_profile() {
    apply_travel_profile "$@"
}

reset_to_defaults() {
    log_title "Resetting Pop!_OS Security Settings to Factory Defaults"

    log_info "Disabling and resetting UFW firewall..."
    if command -v ufw >/dev/null 2>&1; then
        ufw --force disable >/dev/null 2>&1 || true
        ufw --force reset >/dev/null 2>&1 || true
    fi

    log_info "Removing custom security sysctl and limits configurations..."
    rm -f "$SYSCTL_CONF" "$LEGACY_SYSCTL_CONF" "$LIMITS_CONF" "$LEGACY_LIMITS_CONF" "$STATE_FILE" "$LEGACY_STATE_FILE"

    log_info "Reloading standard system sysctl..."
    sysctl --system >/dev/null 2>&1 || true

    log_info "Restoring desktop screen idle timeout to Pop!_OS default (15 minutes)..."
    set_desktop_idle_delay 900

    log_info "Restoring platform power profile to 'balanced' and battery charge threshold to 100%..."
    if command -v system76-power >/dev/null 2>&1; then
        system76-power profile balanced >/dev/null 2>&1 || true
        system76-power charge-thresholds --max 100 >/dev/null 2>&1 || true
    elif command -v powerprofilesctl >/dev/null 2>&1; then
        powerprofilesctl set balanced >/dev/null 2>&1 || true
    fi
    if [ -w /sys/class/power_supply/BAT0/charge_control_limit_max ]; then
        echo 100 > /sys/class/power_supply/BAT0/charge_control_limit_max 2>/dev/null || true
    fi

    log_success "System security and power restored to factory Pop!_OS defaults!"
}

case "${1:-}" in
    -v|--version)
        echo "postureflow version $VERSION"
        exit 0
        ;;
    -h|--help)
        echo "postureflow: Context-Aware Posture Switcher (v$VERSION)"
        echo "Usage: sudo postureflow [profile|action]"
        echo ""
        echo "Profiles:"
        echo "  --home          Home / Streaming / Gaming (Steam, Proton, LocalSend, GSConnect)"
        echo "  --work          Work / Office / Corporate VPN (VPN unblocked, dev ports locked to LAN)"
        echo "  --dev           Developer / Coding (debuggers attach, inotify 524k, dev ports open)"
        echo "  -t, --travel    Hardened Travel / Lockdown (coffee shops, airports, public Wi-Fi)"
        echo "  -s, --secure    Legacy alias for --travel"
        echo ""
        echo "Management & Actions:"
        echo "  -i, --status    Display current security posture, active rules & ports"
        echo "  --score         Calculate and display Real-Time Security Posture Score (0-100%)"
        echo "  --ports         Inspect actively listening sockets and process ownership"
        echo "  --autoflow      Display Auto-Flow network detection and configuration"
        echo "  --triggers      Display App-Aware Dynamic Triggers rules and active app status"
        echo "  -c, --schedule  Display Circadian Schedule, active window & battery telemetry"
        echo "  --test          Run automated anti-lockout & integrity test suite"
        echo "  -r, --reset     Reset all settings back to Pop!_OS factory defaults"
        echo "  --default       Alias for --reset"
        echo "  -h, --help      Show this help menu"
        exit 0
        ;;
    -i|--status|--info)
        show_status
        exit 0
        ;;
    --home)
        if [ "$EUID" -ne 0 ]; then
            log_error "Please run with sudo: sudo postureflow --home"
            exit 1
        fi
        apply_home_profile
        exit 0
        ;;
    --work)
        if [ "$EUID" -ne 0 ]; then
            log_error "Please run with sudo: sudo postureflow --work"
            exit 1
        fi
        apply_work_profile
        exit 0
        ;;
    -d|--dev)
        if [ "$EUID" -ne 0 ]; then
            log_error "Please run with sudo: sudo postureflow --dev"
            exit 1
        fi
        apply_dev_profile
        exit 0
        ;;
    -t|--travel|-s|--secure)
        if [ "$EUID" -ne 0 ]; then
            log_error "Please run with sudo: sudo postureflow --travel"
            exit 1
        fi
        apply_travel_profile
        exit 0
        ;;
    --score)
        if [ -x "$SCRIPT_DIR/../target/release/postureflow-daemon" ]; then
            "$SCRIPT_DIR/../target/release/postureflow-daemon" --score
        elif command -v postureflow-daemon >/dev/null 2>&1; then
            postureflow-daemon --score
        else
            log_error "postureflow-daemon binary required for security cockpit scoring"
            exit 1
        fi
        exit 0
        ;;
    --ports)
        if [ -x "$SCRIPT_DIR/../target/release/postureflow-daemon" ]; then
            "$SCRIPT_DIR/../target/release/postureflow-daemon" --ports
        elif command -v postureflow-daemon >/dev/null 2>&1; then
            postureflow-daemon --ports
        else
            ss -tulpn
        fi
        exit 0
        ;;
    --autoflow)
        if [ -x "$SCRIPT_DIR/../target/release/postureflow-daemon" ]; then
            "$SCRIPT_DIR/../target/release/postureflow-daemon" --autoflow
        elif command -v postureflow-daemon >/dev/null 2>&1; then
            postureflow-daemon --autoflow
        else
            nmcli -t -f TYPE,NAME,DEVICE con show --active
        fi
        exit 0
        ;;
    --triggers)
        if [ -x "$SCRIPT_DIR/../target/release/postureflow-daemon" ]; then
            "$SCRIPT_DIR/../target/release/postureflow-daemon" --triggers
        elif command -v postureflow-daemon >/dev/null 2>&1; then
            postureflow-daemon --triggers
        else
            cat /etc/postureflow/triggers.toml 2>/dev/null || true
        fi
        exit 0
        ;;
    -c|--schedule|--circadian)
        if [ -x "$SCRIPT_DIR/../target/release/postureflow-daemon" ]; then
            "$SCRIPT_DIR/../target/release/postureflow-daemon" --schedule
        elif command -v postureflow-daemon >/dev/null 2>&1; then
            postureflow-daemon --schedule
        else
            cat /etc/postureflow/schedule.toml 2>/dev/null || true
        fi
        exit 0
        ;;
    --test)
        SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
        TEST_SCRIPT="$SCRIPT_DIR/../tests/test_safety.sh"
        if [ -f "$TEST_SCRIPT" ]; then
            bash "$TEST_SCRIPT"
        else
            echo "[*] Running inline safety tests..."
            python3 -c "import socket; s = socket.socket(); s.bind(('127.0.0.1', 0)); s.close()" && echo "[+] Loopback OK"
            sysctl kernel.yama.ptrace_scope >/dev/null && echo "[+] Sysctl OK"
        fi
        exit 0
        ;;
    -r|--reset|reset|--default|default)
        if [ "$EUID" -ne 0 ]; then
            log_error "Please run with sudo: sudo postureflow --reset"
            exit 1
        fi
        reset_to_defaults
        exit 0
        ;;
    *)
        show_status
        echo ""
        echo "To change profile, run:"
        echo "  sudo postureflow --home      # Streaming, gaming, phone sync"
        echo "  sudo postureflow --work      # Office, corporate VPN, printer"
        echo "  sudo postureflow --dev       # Coding & debugging"
        echo "  sudo postureflow --travel    # Lockdown for public Wi-Fi (alias: --secure)"
        echo "  sudo postureflow --reset     # Reset to Pop!_OS factory defaults"
        echo "  postureflow --score          # Real-time Security Cockpit score"
        echo "  postureflow --ports          # Inspect listening ports & processes"
        echo "  postureflow --autoflow       # Check network detection rules"
        echo "  postureflow --triggers       # Check app-aware dynamic trigger status"
        echo "  postureflow --schedule       # Circadian time-of-day schedule & battery"
        exit 0
        ;;
esac
